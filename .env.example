
# Server-only Supabase configuration used by workers and administrative tasks.
# Prefer the current sb_secret_ key format; the legacy service-role key remains
# supported as a fallback by the Python worker.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_KEY=
GROQ_API_KEY=
ENABLE_AI_DAILY_OUTFITS=false
GROQ_VISION_MODEL=

# Curated catalog remote processing. Used only by `extract_and_upload.py process`.
# Supabase credentials are never sent to this service.
CURATED_PIPELINE_URL=
CURATED_PIPELINE_TOKEN=
CURATED_PIPELINE_TIMEOUT_SECONDS=120

# Outfit-photo extraction (enable only after migrations and worker checks pass)
ENABLE_OUTFIT_PHOTO_UPLOAD=false
# HTTPS base URL of the temporary Colab/ngrok bridge or a managed GPU endpoint.
OUTFIT_PIPELINE_URL=
# Long, random server-to-server token; use the same value in Colab Secrets.
OUTFIT_PIPELINE_TOKEN=
OUTFIT_PIPELINE_MODEL=yolos-sam2-flux2-qwen3vl

# Gate 4: Real Groq Vision Provider Configuration (Server-side only)
# Do NOT use NEXT_PUBLIC_* for sensitive keys. These must remain server-side.
# Get a free Groq API key at: https://console.groq.com/keys
AI_PROVIDER_NAME=groq
AI_PROVIDER_API_KEY=
AI_PROVIDER_MODEL=qwen/qwen3.6-27b
AI_PROVIDER_BASE_URL=https://api.groq.com/openai/v1
AI_REQUEST_TIMEOUT_MS=30000

# Optional: Enable live provider tests (REQUIRES valid AI_PROVIDER_API_KEY)
# Usage: AI_LIVE_TEST=true npm run test:ai
AI_LIVE_TEST=

NEXT_PUBLIC_SUPABASE_URL=https://svbkadgcpbpnbfzaqvsf.supabase.co

# Gate 2 RLS Test Accounts
RLS_TEST_USER_A_EMAIL=
RLS_TEST_USER_A_PASSWORD=
RLS_TEST_USER_B_EMAIL=
RLS_TEST_USER_B_PASSWORD=
# Server-side FastAPI base URL; enable ENABLE_AI_DAILY_OUTFITS to use it.
AI_OUTFIT_SERVICE_URL=http://127.0.0.1:8000
# Deadline in milliseconds (capped at 60000). Failures use the local engine.
AI_OUTFIT_SERVICE_TIMEOUT_MS=15000

# ------------------------------------------------------------
# Supabase - server only
# ------------------------------------------------------------

SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_KEY=

# ------------------------------------------------------------
# Existing Groq services
# ------------------------------------------------------------

GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.6-27b
GROQ_VISION_MODEL=unused-for-outfit-photo-test

# ------------------------------------------------------------
# Outfit provider selection
# ------------------------------------------------------------

# notebook = current YOLOS + SAM + Qwen Colab pipeline
# gemini   = new Gemini API pipeline
OUTFIT_PROVIDER=notebook

# ------------------------------------------------------------
# V1 Notebook / Colab provider
# ------------------------------------------------------------

OUTFIT_PIPELINE_URL=
OUTFIT_PIPELINE_TOKEN=
OUTFIT_PIPELINE_MODEL=yolos-sam2-qwen3vl

# ------------------------------------------------------------
# V2 Gemini provider
# ------------------------------------------------------------

GEMINI_API_KEY=
GEMINI_OUTFIT_MODEL=gemini-3.8-flash

# ------------------------------------------------------------
# Outfit processing limits
# ------------------------------------------------------------

OUTFIT_MAX_GARMENTS=8
OUTFIT_PROVIDER_TIMEOUT_SECONDS=90

ENABLE_OUTFIT_PHOTO_UPLOAD=false
